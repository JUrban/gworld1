N5Free := FreeGroup(8);;
N5Gens := GeneratorsOfGroup(N5Free);;
N5ExtWord := function(v)
    local w,i;
    w:=One(N5Free);
    for i in [1,3..Length(v)-1] do w:=w*N5Gens[v[i]]^v[i+1];od;
    return w;
end;
