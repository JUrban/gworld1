% F20 rank two; only Hall commutators of exactly the specified weight are killed.
% cc(X,Y)=X^-1 Y^-1 X Y; cj(X,Y)=Y^-1 X Y.
% Added identities hold in arbitrary groups. No nilpotency axiom.
cnf(assoc,axiom,(mul(mul(X,Y),Z)=mul(X,mul(Y,Z)))).
cnf(left_id,axiom,(mul(one,X)=X)).
cnf(right_id,axiom,(mul(X,one)=X)).
cnf(left_inv,axiom,(mul(inv(X),X)=one)).
cnf(right_inv,axiom,(mul(X,inv(X))=one)).
cnf(inv_inv,axiom,(inv(inv(X))=X)).
cnf(inv_prod,axiom,(inv(mul(X,Y))=mul(inv(Y),inv(X)))).
cnf(inv_one,axiom,(inv(one)=one)).
cnf(comm_def,axiom,(cc(X,Y)=mul(mul(inv(X),inv(Y)),mul(X,Y)))).
cnf(conj_def,axiom,(cj(X,Y)=mul(inv(Y),mul(X,Y)))).
cnf(comm_swap,axiom,(cc(Y,X)=inv(cc(X,Y)))).
cnf(comm_self,axiom,(cc(X,X)=one)).
cnf(comm_one_l,axiom,(cc(one,X)=one)).
cnf(comm_one_r,axiom,(cc(X,one)=one)).
cnf(comm_inv_self,axiom,(cc(X,inv(X))=one)).
cnf(conj_one_l,axiom,(cj(one,X)=one)).
cnf(conj_one_r,axiom,(cj(X,one)=X)).
cnf(conj_self,axiom,(cj(X,X)=X)).
cnf(conj_product,axiom,(cj(X,mul(Y,Z))=cj(cj(X,Y),Z))).
cnf(product_conj,axiom,(cj(mul(X,Y),Z)=mul(cj(X,Z),cj(Y,Z)))).
cnf(conj_inverse,axiom,(cj(inv(X),Y)=inv(cj(X,Y)))).
cnf(conj_comm,axiom,(cj(X,Y)=mul(X,cc(X,Y)))).
cnf(comm_product_l,axiom,(cc(mul(X,Y),Z)=mul(cj(cc(X,Z),Y),cc(Y,Z)))).
cnf(comm_product_r,axiom,(cc(X,mul(Y,Z))=mul(cc(X,Z),cj(cc(X,Y),Z)))).
cnf(comm_inverse_l,axiom,(cc(inv(X),Y)=cj(inv(cc(X,Y)),inv(X)))).
cnf(comm_inverse_r,axiom,(cc(X,inv(Y))=cj(inv(cc(X,Y)),inv(Y)))).
cnf(comm_conj,axiom,(cj(cc(X,Y),Z)=cc(cj(X,Z),cj(Y,Z)))).
cnf(collection,axiom,(mul(X,Y)=mul(mul(Y,X),cc(X,Y)))).
cnf(hall_witt,axiom,(mul(mul(cj(cc(cc(X,inv(Y)),Z),Y),cj(cc(cc(Y,inv(Z)),X),Z)),cj(cc(cc(Z,inv(X)),Y),X))=one)).
cnf(def_003,axiom,(c003=cc(c002,c001))).
cnf(def_004,axiom,(c004=cc(c003,c001))).
cnf(def_005,axiom,(c005=cc(c003,c002))).
cnf(def_006,axiom,(c006=cc(c004,c001))).
cnf(def_007,axiom,(c007=cc(c004,c002))).
cnf(def_008,axiom,(c008=cc(c005,c002))).
cnf(rel_009,axiom,(cc(c004,c003)=one)).
cnf(rel_010,axiom,(cc(c005,c003)=one)).
cnf(rel_011,axiom,(cc(c006,c001)=one)).
cnf(rel_012,axiom,(cc(c006,c002)=one)).
cnf(rel_013,axiom,(cc(c007,c002)=one)).
cnf(rel_014,axiom,(cc(c008,c002)=one)).
cnf(goal,negated_conjecture,(cc(cc(c006,c002),c002)!=one)).
