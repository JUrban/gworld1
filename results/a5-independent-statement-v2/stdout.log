theorem gworld_A5_enumeration : REPred fun m =>
  have p := decodePresentation m;
  (∀ w ∈ p.2, ∀ letter ∈ w, letter.1 < p.1) ∧
    ∀ (a b c d : PresentedGroup {r | r ∈ List.map (interpretWord p.1) p.2}),
      a * b * a⁻¹ * b⁻¹ * (c * d * c⁻¹ * d⁻¹) = c * d * c⁻¹ * d⁻¹ * (a * b * a⁻¹ * b⁻¹) :=
Paper.metabelian_presentations_re
